[Unit]
Description=myIO MQTT Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myio
ExecStart=/opt/myio-bridge/bin/bridge /opt/myio-bridge/data/bridge.json
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=myio-bridge
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/myio-bridge/data
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
